{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "propertyNames": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "additionalProperties": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/]|[A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "enableOnBoot": {
          "type": "boolean"
        },
        "targetScriptName": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "device"
      ],
      "additionalProperties": false
    }
  }
}
