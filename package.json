{
    "name": "shelly-forge",
    "version": "0.4.0",
    "type": "module",
    "description": "A framework for developing Shelly device scripts",
    "author": "Milko Slavov <milko.slavov@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/mslavov/shelly-forge",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mslavov/shelly-forge.git"
    },
    "bin": {
        "shelly-forge": "dist/cli.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.check.json",
        "test": "npm run build && vitest run",
        "test:device": "npm run build && vitest run --config vitest.hardware.config.ts",
        "prepublishOnly": "npm run clean && npm run build",
        "version": "node scripts/sync-template-version.mjs",
        "smoke": "node scripts/smoke-test.mjs",
        "watch": "tsc -p tsconfig.json -w"
    },
    "dependencies": {
        "bonjour-service": "^1.4.4",
        "commander": "^15.0.0",
        "esbuild": "0.28.2",
        "typescript": "^5.9.3",
        "ws": "^8.22.1",
        "zod": "^4.6.7"
    },
    "types": "types/index.d.ts",
    "keywords": [
        "shelly",
        "iot",
        "automation",
        "smart-home"
    ],
    "files": [
        "dist",
        "types",
        "templates",
        "skills",
        "schema"
    ],
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/ws": "^8.18.2",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22.12"
    },
    "exports": {
        ".": {
            "types": "./types/index.d.ts"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "default": "./dist/testing/index.js"
        },
        "./emulator": {
            "types": "./dist/emulator/index.d.ts",
            "default": "./dist/emulator/index.js"
        },
        "./types/*": "./types/*",
        "./schema/*": "./schema/*",
        "./package.json": "./package.json"
    }
}
