{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleDetection": "force",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.test.ts",
    "node_modules/shelly-forge/types/shelly.d.ts"
  ]
}
