{
  "compilerOptions": {
    "target": "es5",
    "moduleDetection": "force",
    "noLib": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "node_modules/shelly-forge/types/lib.shelly.d.ts",
    "node_modules/shelly-forge/types/shelly.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
